{
	"env": {
		"browser": true,
		"es6": true,
		"node": true
	},
	"parser": "typescript-eslint-parser",
	"parserOptions": {
		"ecmaVersion": 2018,
		"sourceType": "module"
	},
	"plugins": ["@typescript-eslint"],
	"rules": {
		"semi": ["warn", "always"],
		"no-console": "off",
		"eqeqeq": ["error", "always"],
		"no-var": "error",
		"prefer-const": "warn",
		"@typescript-eslint/no-inferrable-types": [
			"error",
			{ "ignoreParameters": true }
		],
		"@typescript-eslint/ban-ts-ignore": "error",
		"@typescript-eslint/no-unused-vars": [
			"error",
			{ "args": "none" }
		]
	}
}
